# Create a Kronecker Delta function
def deltakron(i,j):
    if i==j:
        return 1
    else:
        return 0

# Intialize sum variables
sum = 0
sum2 = 0

# Compute using i-j-k
for i in range(3):
    for j in range(3):
        for k in range(3):
            sum += deltakron(i,j)*deltakron(j,k)

# Compute using i-k
for i in range(3):
        for k in range(3):
            sum2 += deltakron(i,k)
